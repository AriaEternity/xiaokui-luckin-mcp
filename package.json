{
  "name": "xiaokui-luckin-mcp",
  "version": "0.1.0",
  "description": "将瑞幸官方 MCP 接入 ChatGPT：OAuth、规格与报价、本人逐笔确认、手动付款。",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {"node": ">=24.20.0 <25", "npm": ">=11.19.0 <12"},
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --max-old-space-size=128 dist/main.js",
    "owner:init": "node scripts/owner-init.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run check:public"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "10.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "fastify": "5.12.5"
  },
  "devDependencies": {"@types/express": "5.0.6", "@types/node": "24.13.3", "typescript": "6.0.3"}
}
