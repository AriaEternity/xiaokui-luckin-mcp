# 仅非秘密配置。npm start不会自动加载.env；本地可用Node --env-file，生产用systemd EnvironmentFile。
PUBLIC_ORIGIN=https://coffee.example.com
DATA_ROOT=/var/lib/xiaokui-luckin
PORT=4318
# systemd模板用LoadCredential覆盖这两个路径；这里仅展示独立配置。
OWNER_FILE=/var/lib/xiaokui-luckin/owner.json
LUCKIN_TOKEN_FILE=/etc/xiaokui-luckin/luckin-token
SYNTHETIC_UPSTREAM=false
ENABLE_PREVIEW=false
ENABLE_ORDERS=false
ENABLE_ORDER_CREATE=false
